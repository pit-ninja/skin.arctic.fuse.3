<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window type="window">
    <controls>
    	<control type="image">
            <description>blackbackground</description>
            <posx>0</posx>
            <posy>0</posy>
            <colordiffuse>FF555555</colordiffuse>
            <aspectratio scalediffuse="false" align="center" aligny="center">scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/screensaver.atv4/resources/skins/default/media/black.jpg</texture>
        </control>
		<control type="videowindow">
			<description>VideoWindow</description>
		    <posx>0</posx>
		    <posy>0</posy>
		    <width>1920</width>
		    <height>1080</height>
		    <visible>true</visible>
		</control>

		<!-- The Shutter Mask: Uses Explicit Visibility linking to guarantee perfectly synced fades -->
        <control type="image">
            <description>Transition Shutter</description>
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/screensaver.atv4/resources/skins/default/media/black.jpg</texture>
            <!-- Render solid black when fade-black is true -->
            <visible>String.IsEqual(Window.Property(fade-black),true)</visible>
            <!-- When True: Fade up to black -->
            <animation effect="fade" start="0" end="100" time="2000">Visible</animation>
            <!-- When False: Fade down to transparent -->
            <animation effect="fade" start="100" end="0" time="2000">Hidden</animation>
        </control>

		<control type="grouplist" id="32504">
		        <!-- Render text only when show-info is true AND the shutter is currently open (false) -->
				<visible>String.IsEqual(Window.Property(show-info),true) + String.IsEqual(Window.Property(fade-black),false) + String.IsEqual(Window.Property(poi-fade-out),false) + String.IsEqual(Window.Property(text-fade-out),false)</visible>
				<!-- When True: Fade in from transparent -->
				<animation effect="fade" start="0" end="100" time="2000">Visible</animation>
				<!-- When False: Fade out to transparent -->
				<animation effect="fade" start="100" end="0" time="2000">Hidden</animation>
				
				<left>60</left>
				<bottom>40</bottom>
				<width>1800</width>
				<height>140</height> 
				<itemgap>-20</itemgap>
				<align>bottom</align>
				<orientation>vertical</orientation>
				<control type="label">
						<width>1800</width>
						<height>70</height> 
						<font>font_head_bold</font> 
						<textcolor>FFFFFFFF</textcolor> 
						<shadowcolor>FF000000</shadowcolor> 
						<aligny>bottom</aligny>
						<align>left</align>
						<label>$INFO[Window.Property(AerialLocationLine1)]</label>
				</control>
				<control type="label">
						<width>1800</width>
						<height>70</height> 
						<font>font_head_bold</font> 
						<textcolor>FFFFFFFF</textcolor> 
						<shadowcolor>FF000000</shadowcolor> 
						<aligny>bottom</aligny>
						<align>left</align>
						<label>$INFO[Window.Property(AerialLocationLine2)]</label>
				</control>
		</control>

		<control type="grouplist" id="32505">
				<!-- Render text only when show-info is true AND the shutter is currently open (false) -->
				<visible>String.IsEqual(Window.Property(show-info),true) + String.IsEqual(Window.Property(show-clock),true) + String.IsEqual(Window.Property(fade-black),false) + String.IsEqual(Window.Property(text-fade-out),false)</visible>
				<!-- When True: Fade in from transparent -->
				<animation effect="fade" start="0" end="100" time="2000">Visible</animation>
				<!-- When False: Fade out to transparent -->
				<animation effect="fade" start="100" end="0" time="2000">Hidden</animation>
				
				<right>60</right>
				<bottom>40</bottom>
				<width>1800</width>
				<height>140</height> 
				<itemgap>0</itemgap>
				<align>bottom</align>
				<orientation>vertical</orientation>
				<control type="label">
						<width>1800</width>
						<height>70</height> 
						<font>font_head_bold</font> 
						<textcolor>FFFFFFFF</textcolor> 
						<shadowcolor>FF000000</shadowcolor> 
						<aligny>bottom</aligny>
						<align>right</align>
						<label>$INFO[System.Time]</label>
				</control>
		</control>
   </controls>
</window>
